# LegUpRx partner code. Falls back to the documented example RFMLPVN1 in dev
# (returns live catalog data). Required in production.
#
# NOTE: RFMLPVN1 is a SHARED DEMO account. Its hosted intake renders the demo
# clinic's branding — "Serenity Spa" — and demo pricing. This is expected, NOT a
# bug: our /go hand-off correctly passes the visitor to medical.leguprecovery.com
# with the partner_id. Swapping in our OWN token (Kearney self-generates) flips
# the intake branding to Modality and the prices to our margin — no code change.
TELEHEALTH_PARTNER_ID=

# Telehealth Supabase project — SEPARATE from the shop/engine project so the
# telehealth business can spin out cleanly later. Service-role key bypasses RLS;
# server-only, never expose to the client.
TELEHEALTH_SUPABASE_URL=
TELEHEALTH_SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 (deferred) — not used by the stage-1 funnel:
#   inbound attribution webhook HMAC secret, member API, wearable connect.
# TELEHEALTH_WEBHOOK_SECRET=
